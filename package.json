{
  "name": "buzzme",
  "version": "1.0.0",
  "description": "BuzzMe is a mobile-friendly platform for meeting random strangers. Its signature feature is random video chat. Voice-only and text-only chat are lighter modes of the same product.",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:ip && npm run test:join && npm run test:matchmaker && npm run test:realtime && npm run test:limiter && npm run test:limits",
    "start": "node src/server.js",
    "test:smoke": "node scripts/smoke-test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:test": "node scripts/test-db.js",
    "test:bans": "node scripts/test-bans.js",
    "test:ip": "node scripts/test-client-ip.js",
    "test:join": "node scripts/test-join.js",
    "test:db": "npm run db:test && npm run test:bans",
    "test:all": "npm test && npm run test:db && npm run test:smoke",
    "test:matchmaker": "node scripts/test-matchmaker.js",
    "test:realtime": "node scripts/test-realtime.js",
    "test:limiter": "node scripts/test-rate-limiter.js",
    "test:limits": "node scripts/test-limits.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MegaMinds-Corporation/buzzme.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MegaMinds-Corporation/buzzme/issues"
  },
  "homepage": "https://github.com/MegaMinds-Corporation/buzzme#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
