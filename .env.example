# Copy to .env and fill in. .env is git-ignored; never commit real values.

PORT=3000
# development | production | test
NODE_ENV=development

# Comma-separated browser origins allowed to open a WebSocket. Required in production.
# Local dev client:  http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL connection string. Keep sslmode=verify-full for hosted databases.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full

# Secret for hashing IPs and device tokens (at least 32 characters).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing it later makes every stored hash unmatchable, which lifts all bans.
IP_HASH_SECRET=

# How many of YOUR proxies (Nginx, platform load balancer) sit in front of this server.
# 0 = none (X-Forwarded-For is ignored). A wrong value lets clients fake their IP.
TRUSTED_PROXY_HOPS=0

# Optional rate limits (defaults are in src/limits.js).
# Concurrent connections allowed per IP. Mobile networks put many people behind one IP, so do not set this too low.
# MAX_CONNECTIONS_PER_IP=10
# Join attempts per IP per minute (valid or not).
# JOIN_RATE_PER_MINUTE=10
# A connection that never joins is dropped after this many milliseconds.
# JOIN_TIMEOUT_MS=60000
